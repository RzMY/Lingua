# 监听地址; 默认只听回环. 非回环地址必须配置下面的访问令牌
LINGUA_HOST=127.0.0.1
LINGUA_PORT=5173

# 配置后 /api/* 均需 Authorization: Bearer <令牌> (OPTIONS 预检除外)
# 留空仅允许回环地址本地免鉴权使用
LINGUA_API_TOKEN=

# UniDic 目录 (只影响日语); 留空则自动用仓库内的 ./dic, 再退回 pip 包 unidic / unidic_lite
LINGUA_DICDIR=

# eSpeak NG 的位置 (只影响西/法/德等语言的音标注音)。两个都留空时用 pip 包
LINGUA_ESPEAK_LIBRARY=
LINGUA_ESPEAK_DATA=
